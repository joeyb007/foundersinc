# Copy to .env and adjust as needed.
PROJECT_NAME="Founders Inc API"
# JSON array of browser origins allowed to call this API.
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic (Claude) API key — used for both the Agent SDK coding agents and
# the plain decompose_epic() classification call.
ANTHROPIC_API_KEY=

# GitHub. One throwaway repo is created per epic and every agent on that epic
# branches off it. Agents run with bypassPermissions and have a shell inside
# the checkout, so scope this token to what you are willing to lose: a
# fine-grained PAT on a throwaway org with Administration:write (create repos),
# Contents:write, and Pull requests:write — NOT an account-wide classic PAT.
#
# The token is never written into .git/config and is scrubbed from any error
# text before that text reaches the run log, but the ceiling on the damage is
# still whatever the token itself can do.
GITHUB_TOKEN=
# Optional. Set to create repos in an org instead of the token owner's account.
GITHUB_ORG=

# `gh` is invoked with GH_TOKEN from the value above, so no `gh auth login`
# is needed on this host.

# Convex callback (Python client can only call public, secret-guarded
# mutations: messages:appendPublic, runs:finishPublic).
CONVEX_URL=
CALLBACK_SECRET=
