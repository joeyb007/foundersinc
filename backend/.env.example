# Copy to .env and adjust as needed.
PROJECT_NAME="Founders Inc API"
# JSON array of browser origins allowed to call this API.
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic (Claude) API key — used for both the Agent SDK coding agents and
# the plain decompose_epic() classification call.
ANTHROPIC_API_KEY=

# Coding agents (Claude Agent SDK) — THROWAWAY repo only; bypassPermissions
# gives agents unrestricted edit/bash inside their isolated per-run checkout.
TARGET_REPO=

# GitHub auth for `git clone`/`git push`/`gh pr create`.
# Local: run `gh auth login` once (no GH_TOKEN needed).
# Hosted/container: set GH_TOKEN to a PAT with `repo` scope — entrypoint.sh runs
# `gh auth setup-git` so git + gh both use it non-interactively.
GH_TOKEN=

# Convex callback (Python client can only call public, secret-guarded
# mutations: messages:appendPublic, runs:finishPublic).
# CONVEX_URL is your Convex deployment URL; CALLBACK_SECRET MUST be identical
# to the CALLBACK_SECRET set in the Convex dashboard, or every callback 401s.
CONVEX_URL=
CALLBACK_SECRET=
