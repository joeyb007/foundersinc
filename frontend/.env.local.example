# Copy to .env.local. `npx convex dev` writes the first two for you.

# Convex deployment the UI subscribes to. Everything the board renders comes
# from here — without it the app shows a setup notice instead of a board.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Cosmetic only: the repo the agents open PRs against, shown on the board.
# Must match TARGET_REPO in backend/.env.
NEXT_PUBLIC_TARGET_REPO=owner/throwaway-repo
